# Application
SYNAPSE_ENV=development
SYNAPSE_LOG_LEVEL=INFO

# PostgreSQL — use local development credentials only
SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:CHANGE_ME@localhost:5432/synapse

# Model gateway — optional; configure only when a provider is selected
SYNAPSE_MODEL_PROVIDER=mock
SYNAPSE_MODEL_API_KEY=
SYNAPSE_MODEL_NAME=

# Execution safety
SYNAPSE_AUTONOMY_ENABLED=false
SYNAPSE_REQUIRE_APPROVAL_FOR_SENSITIVE_ACTIONS=true
